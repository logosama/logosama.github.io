---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro'
const pageTitle = "About Me";

const identity = {
  firstName: "Logos",
  country: "China",
  occupation: "College Student",
  hobbies: ["computer", "writing", "electronic game"],
};

const skills = ["Using Linux System", "Writing Docs"];

const happy = true;
const finished = false;
const goal = 3;

const skillColor = "pink";
const fontWeight = "";
---
<BaseLayout pageTitle={pageTitle}>
  <style define:vars={{skillColor}}>
    h2 {
      color: purple;
      font-size: 2rem;
      }
      .skill {
        color: var(--skillColor);
        font-weight: bold;
      }
      </style>

  <h2>Here is something about me!</h2>

  
  <p>Here are a few facts about me:</p>
  <ul>
    <li>My name is {identity.firstName}.</li>
    <li>I live in {identity.country} and I work as a {identity.occupation}.</li>
    {identity.hobbies.length >= 2 &&
          <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
        }
  </ul>

  <p>My skills are:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>
  
  {happy && <p>I am happy to be learning Astro!</p>}
  
  {finished && <p>I finished this tutorial!</p>}
  
  {goal === 3 && 0 ? <p>My goal is to finish in 3 days.</p> : <p>My goal is not 3 days.</p>}
  
  <div>
      Long as the cosmos borned, pure and mysterious as itself.
      Only planets float around, far far path and long long span.
      God never tells the truth, lies broken and built.
      Original wildness makes us, puzzles left for us.
      Since logic wears fate, selfishness and arrogance shine.
  </div>

  <p style="color: grey">This site will update as I complete more of the tutorial, so keep checking back and see how my journey is going!</p>
  <p> CONTACT ME: https://i.delta.chat/#A55E47CA21BDEF9234B981D3554BBBB04A781B93&v=3&i=YDUyf8u2Z0UeOf_avknfq0PE&s=kIuL1k4JaMOQT7P6lHRRme-2&a=gdf8efqtg%40chat.tinydispatch.org&r=ikjkpwjgy@chat.nuvon.app,v8kjoz2wo%40chat.vim.wtf&n=logos</p>
</BaseLayout>
